# Boston Begins — everything is served through the PHP gate.
# Direct requests to any file (css, js, json, images) are rewritten to
# index.php, which verifies the access cookie before streaming the file.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve the private directory, rewritten or otherwise.
    RewriteRule ^private(/|$) - [F,L]

    # Everything except index.php itself goes through the front controller.
    RewriteCond %{REQUEST_URI} !index\.php$
    RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]
</IfModule>

# Belt and suspenders if rewriting is unavailable: block sensitive files.
<FilesMatch "\.(json|md|key)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
